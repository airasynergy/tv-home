<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false">

    <!-- Top Shelf wallpaper: the focused app's art, blurred and dimmed (two layers to crossfade) -->
    <ImageView
        android:id="@+id/wallA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/wallB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/wallShade"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/wallVignette"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/scroller"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="72dp"
            android:paddingTop="40dp"
            android:paddingEnd="72dp"
            android:paddingBottom="96dp">

            <!-- Greeting + date (left), clock (right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_display_semibold"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.02"
                        android:shadowColor="#59000000"
                        android:shadowRadius="16"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/inter_medium"
                        android:letterSpacing="0.01"
                        android:textColor="#8CFFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.01"
                    android:shadowColor="#59000000"
                    android:shadowRadius="16"
                    android:textColor="#F2FFFFFF"
                    android:textSize="24sp" />
            </LinearLayout>

            <!-- Top Shelf: name of the focused app, sitting just above the Top Row -->
            <LinearLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:gravity="bottom"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/heroKicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/inter_semibold"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true"
                    android:textColor="#99FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/heroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_display_bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.035"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowRadius="24"
                    android:textColor="#FFFFFF"
                    android:textSize="56sp" />

                <TextView
                    android:id="@+id/heroSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="#A6FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Top Row (favourites) -->
            <HorizontalScrollView
                android:id="@+id/dockScroller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-72dp"
                android:layout_marginEnd="-72dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="72dp"
                android:paddingTop="26dp"
                android:paddingEnd="72dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/dockRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/allAppsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="-0.01"
                android:text="All Apps"
                android:textColor="#CCFFFFFF"
                android:textSize="18sp" />

            <!-- Grid of every other installed app -->
            <LinearLayout
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
